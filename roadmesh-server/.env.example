# ─── RoadMesh Server Environment Variables ───────────────────────────────────
#
# Copy this file to .env and fill in your values.
# The server reads these at startup via process.env.

# ─── HTTP / WebSocket ────────────────────────────────────────────────────────
HTTP_PORT=3000

# ─── MQTT Broker ─────────────────────────────────────────────────────────────
MQTT_PORT=1883

# ─── Vehicle Tracking ─────────────────────────────────────────────────────────
# Radius (in meters) to search for nearby vehicles
NEARBY_RADIUS_METERS=500

# How long (ms) a vehicle can go without updates before being removed
VEHICLE_TIMEOUT_MS=10000

# How many seconds ahead to project vehicle trajectories for collision detection
COLLISION_HORIZON_SEC=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# ─── Logging ─────────────────────────────────────────────────────────────────
# Set to 'debug' for verbose output, 'info' for normal, 'error' for quiet
LOG_LEVEL=info
