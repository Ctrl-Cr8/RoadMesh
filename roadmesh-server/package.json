{
    "name": "roadmesh-server",
    "version": "1.0.0",
    "description": "RoadMesh Cooperative Vehicle Awareness Backend Server",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc && node -e \"require('fs').cpSync('src/dashboard', 'dist/dashboard', {recursive: true})\"",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/ws": "^8.5.14",
        "cors": "^2.8.5",
        "express": "^4.21.2",
        "express-rate-limit": "^8.6.2",
        "ngeohash": "^0.6.3",
        "typescript": "^5.7.3",
        "uuid": "^11.1.0",
        "ws": "^8.18.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/supertest": "^7.2.1",
        "@types/uuid": "^10.0.0",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "vitest": "^3.0.4"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
